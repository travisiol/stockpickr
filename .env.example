# ---------------------------------------------------------------------------
# STOCKPICKR
#
# Everything here is optional. With none of it set the site runs end to end:
# the terminal opens in paper mode, orders settle against a practice balance,
# and the UI says so rather than pretending to be live.
# ---------------------------------------------------------------------------

# Wallet provider. Setting this switches the terminal out of paper mode:
# sign-in, balances, swaps and positions become real, and every order is
# signed in the user's own wallet. Leave it empty to stay on paper.
#
# Get one from your wallet-infrastructure provider. Do not reuse an app id
# that belongs to somebody else's product.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# The token, the treasury and the rewards distributor live in src/lib/site.ts
# rather than here, because they are public values the client renders and not
# secrets:
#
#   site.ca        the coin's contract address. Empty renders "CA: soon".
#   site.treasury  the wallet the rewards pool accrues into. Empty makes the
#                  landing page show "Not yet" instead of reading a balance
#                  that is not ours to quote.
#   site.rewards   the Picker Rewards distributor. Empty means claiming is
#                  not live, and /api/claim refuses instead of returning a
#                  transaction hash that does not exist.
# ---------------------------------------------------------------------------
